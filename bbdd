CREATE DATABASE IF NOT EXISTS practicas_pedagogicas
  CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE practicas_pedagogicas;

CREATE TABLE usuario (
    id_usuario      BIGINT AUTO_INCREMENT PRIMARY KEY,
    nombre          VARCHAR(150) NOT NULL,
    email           VARCHAR(150) NOT NULL UNIQUE,
    password_hash   VARCHAR(255) NOT NULL,
    rol             ENUM('ESTUDIANTE','COLABORADOR','TUTOR','PROFESOR_ASIGNATURA','COORDINADOR') NOT NULL,
    creado_en       TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

CREATE TABLE estudiante (
    id_usuario   BIGINT PRIMARY KEY,
    carrera      VARCHAR(150) NOT NULL,
    CONSTRAINT fk_estudiante_usuario FOREIGN KEY (id_usuario) REFERENCES usuario(id_usuario) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE centro_de_practica (
    id_centro    BIGINT AUTO_INCREMENT PRIMARY KEY,
    nombre       VARCHAR(200) NOT NULL,
    comuna       VARCHAR(100),
    tipo         ENUM('MUNICIPAL','SUBVENCIONADO','PARTICULAR','EDUCACION_ADULTOS') NOT NULL
) ENGINE=InnoDB;

CREATE TABLE profesor_colaborador (
    id_usuario   BIGINT PRIMARY KEY,
    id_centro    BIGINT NOT NULL,
    CONSTRAINT fk_colaborador_usuario FOREIGN KEY (id_usuario) REFERENCES usuario(id_usuario) ON DELETE CASCADE,
    CONSTRAINT fk_colaborador_centro  FOREIGN KEY (id_centro)  REFERENCES centro_de_practica(id_centro)
) ENGINE=InnoDB;

CREATE TABLE profesor_tutor (
    id_usuario   BIGINT PRIMARY KEY,
    CONSTRAINT fk_tutor_usuario FOREIGN KEY (id_usuario) REFERENCES usuario(id_usuario) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE profesor_asignatura (
    id_usuario   BIGINT PRIMARY KEY,
    CONSTRAINT fk_profasig_usuario FOREIGN KEY (id_usuario) REFERENCES usuario(id_usuario) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE asignatura (
    id_asignatura     BIGINT AUTO_INCREMENT PRIMARY KEY,
    nombre            VARCHAR(150) NOT NULL,
    ciclo             ENUM('INICIAL','INTERMEDIO','FINAL') NOT NULL,
    numero_lineas     TINYINT NOT NULL DEFAULT 1,   -- 1 = unica, 2 = especialidad+orientacion
    semestre_carrera  TINYINT NOT NULL
) ENGINE=InnoDB;

CREATE TABLE matricula (
    id_matricula            BIGINT AUTO_INCREMENT PRIMARY KEY,
    id_estudiante           BIGINT NOT NULL,
    id_asignatura           BIGINT NOT NULL,
    id_centro               BIGINT NOT NULL,
    id_profesor_asignatura  BIGINT NOT NULL,
    anio                    SMALLINT NOT NULL,
    semestre                TINYINT NOT NULL,
    CONSTRAINT fk_matricula_estudiante  FOREIGN KEY (id_estudiante)          REFERENCES estudiante(id_usuario),
    CONSTRAINT fk_matricula_asignatura  FOREIGN KEY (id_asignatura)          REFERENCES asignatura(id_asignatura),
    CONSTRAINT fk_matricula_centro      FOREIGN KEY (id_centro)              REFERENCES centro_de_practica(id_centro),
    CONSTRAINT fk_matricula_profesor    FOREIGN KEY (id_profesor_asignatura) REFERENCES profesor_asignatura(id_usuario),
    UNIQUE KEY uq_matricula (id_estudiante, id_asignatura, anio, semestre)
) ENGINE=InnoDB;

CREATE TABLE linea_practica (
    id_linea        BIGINT AUTO_INCREMENT PRIMARY KEY,
    id_matricula    BIGINT NOT NULL,
    tipo            ENUM('UNICA','ESPECIALIDAD','ORIENTACION') NOT NULL,
    id_colaborador  BIGINT NOT NULL,
    id_tutor        BIGINT NULL,  -- solo se completa en Practica Profesional
    CONSTRAINT fk_linea_matricula    FOREIGN KEY (id_matricula)   REFERENCES matricula(id_matricula) ON DELETE CASCADE,
    CONSTRAINT fk_linea_colaborador  FOREIGN KEY (id_colaborador) REFERENCES profesor_colaborador(id_usuario),
    CONSTRAINT fk_linea_tutor        FOREIGN KEY (id_tutor)       REFERENCES profesor_tutor(id_usuario)
) ENGINE=InnoDB;

CREATE TABLE pauta_evaluacion (
    id_pauta              BIGINT AUTO_INCREMENT PRIMARY KEY,
    id_asignatura         BIGINT NOT NULL,
    tipo_linea            ENUM('UNICA','ESPECIALIDAD','ORIENTACION') NOT NULL,
    numero_aplicacion     TINYINT NOT NULL DEFAULT 1,   -- 1ra, 2da, etc.
    ponderacion           DECIMAL(5,2) NOT NULL,        -- % sobre la nota final
    estructura_criterios  JSON NOT NULL,                -- dimensiones/criterios, varian por asignatura
    CONSTRAINT fk_pauta_asignatura FOREIGN KEY (id_asignatura) REFERENCES asignatura(id_asignatura)
) ENGINE=InnoDB;

CREATE TABLE evaluacion_aplicada (
    id_evaluacion        BIGINT AUTO_INCREMENT PRIMARY KEY,
    id_linea             BIGINT NOT NULL,
    id_pauta             BIGINT NOT NULL,
    tipo_evaluador       ENUM('COLABORADOR','TUTOR') NOT NULL,
    puntaje_total        DECIMAL(6,2),
    nota_voz_url         VARCHAR(500),
    transcripcion_texto  TEXT,
    fecha                DATETIME NOT NULL,
    CONSTRAINT fk_eval_linea FOREIGN KEY (id_linea) REFERENCES linea_practica(id_linea) ON DELETE CASCADE,
    CONSTRAINT fk_eval_pauta FOREIGN KEY (id_pauta) REFERENCES pauta_evaluacion(id_pauta)
) ENGINE=InnoDB;

CREATE TABLE planificacion (
    id_planificacion   BIGINT AUTO_INCREMENT PRIMARY KEY,
    id_linea           BIGINT NOT NULL,
    contenido          TEXT NOT NULL,
    estado             ENUM('ENVIADA','APROBADA','RECHAZADA') NOT NULL DEFAULT 'ENVIADA',
    retroalimentacion  TEXT,
    fecha_envio        DATETIME NOT NULL,
    fecha_retro        DATETIME NULL,
    CONSTRAINT fk_planificacion_linea FOREIGN KEY (id_linea) REFERENCES linea_practica(id_linea) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE interaccion_chatbot (
    id_interaccion      BIGINT AUTO_INCREMENT PRIMARY KEY,
    id_planificacion    BIGINT NOT NULL,
    mensaje_estudiante  TEXT NOT NULL,
    respuesta_bot       TEXT NOT NULL,
    fecha               DATETIME NOT NULL,
    CONSTRAINT fk_interaccion_planificacion FOREIGN KEY (id_planificacion) REFERENCES planificacion(id_planificacion) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE documento_estudiante (
    id_documento    BIGINT AUTO_INCREMENT PRIMARY KEY,
    id_matricula    BIGINT NOT NULL,
    tipo            ENUM('INFORME','PRODUCTO','PROYECTO_INTERVENCION') NOT NULL,
    numero          TINYINT NOT NULL,
    contenido_url   VARCHAR(500) NOT NULL,
    fecha_subida    DATETIME NOT NULL,
    CONSTRAINT fk_documento_matricula FOREIGN KEY (id_matricula) REFERENCES matricula(id_matricula) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE informe_final (
    id_informe            BIGINT AUTO_INCREMENT PRIMARY KEY,
    id_matricula          BIGINT NOT NULL UNIQUE,
    calificacion_sugerida DECIMAL(3,1),
    calificacion_final    DECIMAL(3,1),
    fecha_generacion      DATETIME,
    fecha_publicacion     DATETIME NULL,
    id_validador          BIGINT NOT NULL,
    CONSTRAINT fk_informe_matricula FOREIGN KEY (id_matricula) REFERENCES matricula(id_matricula) ON DELETE CASCADE,
    CONSTRAINT fk_informe_validador FOREIGN KEY (id_validador) REFERENCES profesor_asignatura(id_usuario)
) ENGINE=InnoDB;
